{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OCSF Event Schema v1.1.0 (Air-gapped Vendored)",
  "type": "object",
  "required": [
    "class_uid",
    "category_uid",
    "severity_id",
    "time",
    "metadata",
    "raw_ref"
  ],
  "properties": {
    "class_uid": { "type": "integer", "description": "OCSF Class Unique Identifier" },
    "class_name": { "type": "string" },
    "category_uid": { "type": "integer", "description": "OCSF Category Unique Identifier" },
    "category_name": { "type": "string" },
    "severity_id": { "type": "integer" },
    "activity_id": { "type": "integer" },
    "activity_name": { "type": "string" },
    "time": { "type": "integer", "description": "Event timestamp in epoch seconds" },
    "disposition": { "type": "string" },
    "metadata": {
      "type": "object",
      "required": ["version", "product"],
      "properties": {
        "version": { "type": "string" },
        "product": {
          "type": "object",
          "required": ["vendor_name", "name"],
          "properties": {
            "vendor_name": { "type": "string" },
            "name": { "type": "string" }
          }
        }
      }
    },
    "raw_ref": {
      "type": "object",
      "required": ["uuid", "sha256", "archive_path"],
      "properties": {
        "uuid": { "type": "string" },
        "sha256": { "type": "string" },
        "archive_path": { "type": "string" }
      }
    },
    "parser_id": { "type": "string" },
    "parser_version": { "type": "string" },
    "src_endpoint": {
      "type": "object",
      "properties": {
        "ip": { "type": "string" },
        "port": { "type": "integer" }
      }
    },
    "dst_endpoint": {
      "type": "object",
      "properties": {
        "ip": { "type": "string" },
        "port": { "type": "integer" }
      }
    },
    "user": {
      "type": "object",
      "properties": {
        "name": { "type": "string" }
      }
    },
    "device": {
      "type": "object",
      "properties": {
        "hostname": { "type": "string" }
      }
    }
  }
}
