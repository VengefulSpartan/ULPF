# TRACELOG environment configuration
PROJECT_NAME="TRACELOG — Universal Log Pre-processing Framework"
VERSION="1.0.0"
ENVIRONMENT="local" # local, demo, production
DEBUG=True

# Network bindings
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=8000
FRONTEND_PORT=8501

# Storage
DB_PATH="data/ulpf.db"
# OCSF schema version stamped on every event: 1.1.0, 1.2.0 or 1.3.0 (what TRACELOG has verified its
# classes against). Amazon Security Lake reads 1.3 and earlier. See docs/adr/0001-ocsf-version.md.
OCSF_VERSION="1.1.0"
# Full-text index over the archived lines: searching is a lookup instead of a scan (3 ms instead of
# 330 ms over 100k stored lines), at about a quarter of the ingest rate. Set false for a forwarder
# that is never searched. See docs/PERFORMANCE.md.
SEARCH_INDEX=true
# Run the baseline detector as each window of this many minutes closes and write its flags as
# Detection Findings (docs/ML_DATA.md). 0 leaves it off; scripts/run_baseline.py runs it on demand.
BASELINE_EVERY_MINUTES=0

# Optional LLM Integration (Left empty for 100% offline air-gapped mode)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Connectors (read by config/tracelog.yaml as ${VAR}; leave empty for the ones you do not use)
TRACELOG_CONFIG="config/tracelog.yaml"
TRACELOG_HEC_TOKEN=""        # require this token on the HEC / OTLP / stream receivers
SPLUNK_HEC_TOKEN=""
ELASTIC_API_KEY=""
OPENSEARCH_PASSWORD=""
WAZUH_INDEXER_PASSWORD=""
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
DD_API_KEY=""
NEW_RELIC_LICENSE_KEY=""
SOAR_TOKEN=""
